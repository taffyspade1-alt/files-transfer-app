# 依赖
node_modules/

# ===== 运行时数据：数据库 + 自动生成的会话密钥，不进仓库 =====
# session.key 泄露 = 别人可以伪造登录 Cookie
data/*
!data/.gitkeep

# ===== 用户上传的文件：体积大、含隐私，不进仓库 =====
storage/*
!storage/.gitkeep

# 构建产物
dist/
build/
.output/

# 环境变量（含密钥，绝对不能提交）
.env
.env.local
.env.*.local

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 大文件
*.mp4
*.zip
*.exe
*.psd